{
  "name": "gym-tracker-pwa",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "tsx backend/src/server.ts",
    "dev:all": "concurrently -k \"npm:dev:api\" \"npm:dev\"",
    "build": "tsc -b && vite build",
