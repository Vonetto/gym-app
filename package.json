    "dexie": "^4.0.8",
    "fastify": "^5.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "@vitest/coverage-v8": "^4.0.18",
    "concurrently": "^9.1.2",
    "dotenv": "^16.4.7",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^28.1.0",
    "tsx": "^4.20.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-pwa": "^0.20.5",
    "vitest": "^4.0.18",
    "workbox-core": "^7.3.0",
